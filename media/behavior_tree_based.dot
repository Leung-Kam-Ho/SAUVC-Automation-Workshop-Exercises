digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
"Overall Timeout" [label="Overall Timeout", shape=ellipse, style=filled, fillcolor=ghostwhite, fontsize=9, fontcolor=black];
RootSequence [label="Ⓜ RootSequence", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
"Overall Timeout" -> RootSequence;
"Initial Setup" [label="Ⓜ Initial Setup", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
